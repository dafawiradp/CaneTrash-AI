# Copy to .env and adjust for your environment.
# Every value below has a safe default in backend/config.py, so an empty
# .env (or no .env at all) is enough to run the app locally.

APP_ENV=development
DEBUG=true

# --- Database ---
# Local dev default (no external DB needed):
DATABASE_URL=sqlite+aiosqlite:///./canetrash.db
# Production example:
# DATABASE_URL=postgresql+asyncpg://canetrash:password@localhost:5432/canetrash

# --- Hardware ---
USE_HARDWARE_SIMULATORS=true
WEIGHBRIDGE_PORT=/dev/ttyUSB0
WEIGHBRIDGE_BAUDRATE=9600
WEIGHBRIDGE_MODBUS_UNIT_ID=1

# --- AI Core ---
# Leave FORCE_SYNTHETIC_AI=true until real YOLOv10/SAM2 weights + open3d are installed.
FORCE_SYNTHETIC_AI=true
SEGMENTATION_WEIGHTS_PATH=
SEGMENTATION_CONFIDENCE_THRESHOLD=0.35
LIDAR_VOXEL_SIZE_M=0.05

# --- SLM Agent ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
VLLM_BASE_URL=

# --- Mill business rules ---
DEFAULT_BASE_PRICE_PER_TON=850000

# --- Slip printer ---
SLIP_PRINTER_DEVICE=mock://thermal_printer_01
